{
  "routes": [
    {
      "src": "/customer_authentication/(.*)",
      "dest": "https://restrito.sobinvestigacao.com/customer_authentication/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://restrito.sobinvestigacao.com/auth/$1"
    },
    {
      "src": "/challenge/(.*)",
      "dest": "https://restrito.sobinvestigacao.com/challenge/$1"
    },
    {
      "src": "/account",
      "dest": "https://restrito.sobinvestigacao.com/account"
    },
    {
      "src": "/account/(.*)",
      "dest": "https://restrito.sobinvestigacao.com/account/$1"
    },
    {
      "src": "/checkout",
      "dest": "https://restrito.sobinvestigacao.com/checkout"
    },
    {
      "src": "/checkout/(.*)",
      "dest": "https://restrito.sobinvestigacao.com/checkout/$1"
    },
    {
      "src": "/pages/(.*)",
      "status": 307,
      "headers": { "Location": "https://restrito.sobinvestigacao.com/pages/$1" }
    },
    {
      "src": "/(.*)",
      "dest": "https://shop.sobinvestigacao.com/$1"
    }
  ]
}
