{
  "rewrites": [
    {
      "source": "/",
      "destination": "https://shop.sobinvestigacao.com/"
    },
    {
      "source": "/customer_authentication/:path*",
      "destination": "https://loja.sobinvestigacao.com/customer_authentication/:path*"
    },
    {
      "source": "/challenge/:path*",
      "destination": "https://loja.sobinvestigacao.com/challenge/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://loja.sobinvestigacao.com/auth/:path*"
    },
    {
      "source": "/account",
      "destination": "https://loja.sobinvestigacao.com/account"
    },
    {
      "source": "/account/:path*",
      "destination": "https://loja.sobinvestigacao.com/account/:path*"
    },
    {
      "source": "/checkout",
      "destination": "https://loja.sobinvestigacao.com/checkout"
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://loja.sobinvestigacao.com/checkout/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://shop.sobinvestigacao.com/:path*"
    }
  ]
}
